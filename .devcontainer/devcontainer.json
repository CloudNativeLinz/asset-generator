
{
  "name": "imagegen",
  "image": "mcr.microsoft.com/devcontainers/python:3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:2.1.0": {
      "version": "lts",
      "npmVersion": "none",
      "pnpmVersion": "none"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      },
      "mcp": {
        "servers": {
          "io.github.upstash/context7": {
            "type": "stdio",
            "command": "npx",
            "args": [
              "-y",
              "@upstash/context7-mcp@1.0.31"
            ]
          },
          "microsoft/playwright-mcp": {
            "type": "stdio",
            "command": "npx",
            "args": [
              "-y",
              "@playwright/mcp@latest"
            ]
          }
        }
      }
    }
  },
  "postCreateCommand": "pip install -e .[dev] && sudo bash -c 'ln -sf /usr/local/share/nvm/current/bin/node /usr/local/bin/node && ln -sf /usr/local/share/nvm/current/bin/npm /usr/local/bin/npm && ln -sf /usr/local/share/nvm/current/bin/npx /usr/local/bin/npx && echo \\\"export PATH=/usr/local/bin:/usr/local/share/nvm/current/bin:\\$PATH\\\" >> /etc/profile'",
  "postStartCommand": "sudo bash -c 'ln -sf /usr/local/share/nvm/current/bin/node /usr/local/bin/node && ln -sf /usr/local/share/nvm/current/bin/npm /usr/local/bin/npm && ln -sf /usr/local/share/nvm/current/bin/npx /usr/local/bin/npx && echo \\\"PATH=/usr/local/bin:/usr/local/share/nvm/current/bin:\\$PATH\\\" > /etc/environment'",
  "remoteEnv": {
    "PATH": "/usr/local/bin:/usr/local/share/nvm/current/bin:${containerEnv:PATH}"
  },
  "forwardPorts": [
    8000
  ],
  "remoteUser": "vscode"
}
